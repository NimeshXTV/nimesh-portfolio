---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Backend Engineer | Systems & Architecture",
	title: "Home",
};
---

<PageLayout meta={meta}>
	<!-- Hero -->
	<section class="mb-16">
		<h1 class="title mb-4">Hi, I'm Nimesh Sharma</h1>
		<p class="text-accent mb-4 text-2xl">Backend Engineer | Systems & Architecture</p>
		<p class="mb-6 max-w-2xl leading-relaxed">
			I build scalable backend systems with Java and modern patterns. Focused on multithreading,
			system design, and high-performance architectures. Clean code, real-world problems.
		</p>
		<div class="flex flex-wrap gap-4">
			<a
				href="/resume.pdf"
				download
				class="border-accent text-accent hover:bg-accent hover:text-global-bg mt-2 inline-block rounded-lg border-2 px-6 py-2.5 font-bold no-underline transition-colors"
			>
				My Resume
			</a>
		</div>
	</section>

	<!-- Experience -->
	<section class="mb-16">
		<h2 class="title mb-8">Experience</h2>
		<div class="border-accent border-l-2 pl-6">
			<h3 class="mb-2 text-xl font-bold">Technical Team Lead</h3>
			<p class="text-accent mb-1">Computer Engineering Society, Siliguri Institute of Technology</p>
			<p class="mb-4 text-sm opacity-75">Aug 2025 – Jan 2026</p>
			<ul class="space-y-2 text-sm">
				<li>• Organized and ran 45-day DSA challenge with 50+ participants</li>
				<li>• Handled scoring for Industry Connect event (150+ students)</li>
				<li>• Hosted hackathons for 40+ teams</li>
				<li>• Promoted from Junior Associate after 5 months</li>
			</ul>
		</div>
	</section>

	<!-- Projects -->
	<section>
		<h2 class="title mb-8">Projects</h2>
		<div class="space-y-6">
			<div>
				<a
					href="/projects/multithreaded-web-server/"
					class="cactus-link mb-1 block font-bold">Multithreaded Web Server</a
				>
				<p class="text-sm leading-relaxed opacity-75">
					Java • A TCP echo server benchmarked to 39,000 msg/sec — five threads beat fifty, and
					thread-per-connection fails under load
				</p>
			</div>
			<div>
				<a
					href="/projects/banking-management-system/"
					class="cactus-link mb-1 block font-bold">Banking Management System</a
				>
				<p class="text-sm leading-relaxed opacity-75">
					Java • 1,000 concurrent transfers, zero money created or destroyed — JDBC transactions
					proven under fire
				</p>
			</div>
			<div>
				<a
					href="/projects/benfords-law-analyzer/"
					class="cactus-link mb-1 block font-bold">Benford's Law Analyzer</a
				>
				<p class="text-sm leading-relaxed opacity-75">
					Python • Extract 652 numbers from a financial PDF and prove statistically whether they're
					natural or manipulated — in 2.6 seconds
				</p>
			</div>
			<div>
				<a
					href="/projects/ticket-booking-system/"
					class="cactus-link mb-1 block font-bold">Ticket Booking System</a
				>
				<p class="text-sm leading-relaxed opacity-75">
					Java • 100 threads raced for the last seat 1,000 times — the unsynchronized code
					double-booked in 24 rounds and crashed in 5. One word fixed it
				</p>
			</div>
		</div>
	</section>
</PageLayout>
