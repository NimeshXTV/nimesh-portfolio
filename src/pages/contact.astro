---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Get in touch with Nimesh Sharma",
	title: "Contact",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Get in Touch</h1>
	<div class="space-y-12 max-w-2xl">
		<div>
			<p class="mb-6">
				I'm always interested in discussing data projects, learning opportunities, or just chatting about technology and markets. Feel free to reach out!
			</p>
		</div>

		<div class="space-y-4">
			<div class="p-6 border border-accent rounded">
				<h3 class="text-xl font-bold mb-2">Email</h3>
				<a href="mailto:nimeshsharma760@gmail.com" class="cactus-link font-semibold">nimeshsharma760@gmail.com</a>
				<p class="text-sm opacity-75 mt-2">I usually respond within 24 hours</p>
			</div>

			<div class="p-6 border border-accent rounded">
				<h3 class="text-xl font-bold mb-2">Phone</h3>
				<a href="tel:+918918150944" class="cactus-link font-semibold">+91 8918150944</a>
				<p class="text-sm opacity-75 mt-2">Available for calls on weekdays</p>
			</div>

			<div class="p-6 border border-accent rounded">
				<h3 class="text-xl font-bold mb-2">Location</h3>
				<p class="cactus-link font-semibold">Bengaluru, Karnataka, India</p>
				<p class="text-sm opacity-75 mt-2">Studying at Siliguri Institute of Technology</p>
			</div>
		</div>

		<div class="bg-accent bg-opacity-10 p-8 rounded">
			<h2 class="text-2xl font-bold mb-4">Connect on Social Media</h2>
			<div class="space-y-3">
				<p><a href="https://github.com/NimeshXTV" target="_blank" class="cactus-link">GitHub</a> - @NimeshXTV</p>
				<p><a href="https://www.linkedin.com/in/nimesh-sharma-5aa961286/" target="_blank" class="cactus-link">LinkedIn</a> - Connect</p>
				<p><a href="https://medium.com/@nimeshsharma760" target="_blank" class="cactus-link">Medium</a> - Read my writing</p>
			</div>
		</div>

		<div>
			<h2 class="text-2xl font-bold mb-4">What I'm Looking For</h2>
			<ul class="space-y-2">
				<li>• Data Analytics roles and internships</li>
				<li>• Opportunities to work with real datasets</li>
				<li>• Collaborations on data-driven projects</li>
				<li>• Mentorship and learning opportunities</li>
			</ul>
		</div>
	</div>
</PageLayout>
