---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Get in touch with Nimesh Sharma",
	title: "Contact",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-8">Get in Touch</h1>
	<div class="max-w-2xl space-y-12">
		<div>
			<p class="mb-6">
				I'm interested in discussing backend projects, system design, or technology in general. Feel
				free to reach out!
			</p>
		</div>

		<div class="space-y-4">
			<div class="border-accent rounded border p-6">
				<h3 class="mb-2 text-xl font-bold">Email</h3>
				<a href="mailto:nimeshsharma760@gmail.com" class="cactus-link font-semibold"
					>nimeshsharma760@gmail.com</a
				>
				<p class="mt-2 text-sm opacity-75">I usually respond within 24 hours</p>
			</div>

			<div class="border-accent rounded border p-6">
				<h3 class="mb-2 text-xl font-bold">Location</h3>
				<p class="cactus-link font-semibold">Bengaluru, Karnataka, India</p>
				<p class="mt-2 text-sm opacity-75">Studying at Siliguri Institute of Technology</p>
			</div>
		</div>

		<div class="bg-accent bg-opacity-10 rounded p-8">
			<h2 class="mb-4 text-2xl font-bold">Connect on Social Media</h2>
			<div class="space-y-3">
				<p>
					<a href="https://github.com/NimeshXTV" target="_blank" class="cactus-link">GitHub</a> - @NimeshXTV
				</p>
				<p>
					<a
						href="https://www.linkedin.com/in/nimesh-sharma-5aa961286/"
						target="_blank"
						class="cactus-link">LinkedIn</a
					> - Connect
				</p>
				<p>
					<a href="https://medium.com/@nimeshsharma760" target="_blank" class="cactus-link"
						>Medium</a
					> - Read my writing
				</p>
			</div>
		</div>
	</div>
</PageLayout>
