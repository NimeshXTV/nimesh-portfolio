---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Nimesh Sharma - Data-Driven Problem Solver",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">About Me</h1>
	<div class="space-y-8">
		<section>
			<p class="mb-6">
				Hi, I'm Nimesh Sharma, a backend engineer passionate about building systems that scale. 
				I'm a student at Siliguri Institute of Technology, exploring multithreading, system design, 
				and high-performance architectures.
			</p>
		</section>

		<section>
			<h2 class="title mb-4">Education</h2>
			<div class="border-accent border-l-2 pl-6">
				<h3 class="text-xl font-bold">Bachelor of Technology - Computer Science</h3>
				<p class="text-accent mb-1">Siliguri Institute of Technology</p>
				<p class="text-sm opacity-75">Aug 2023 – July 2027 | CGPA: 7.58</p>
			</div>
		</section>

		<section>
			<h2 class="title mb-4">Skills</h2>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
				<div>
					<h3 class="text-accent mb-2 font-bold">Languages</h3>
					<p>Java, C, JavaScript, C, HTML, CSS</p>
				</div>
				<div>
					<h3 class="text-accent mb-2 font-bold">Frameworks & Tools</h3>
					<p>Spring Boot, REST APIs, JDBC, JUnit, Maven, Git, GitHub, IntelliJ IDEA, Linux</p>
				</div>
				<div>
					<h3 class="text-accent mb-2 font-bold">Databases</h3>
					<p>MySQL, PostgreSQL</p>
				</div>
				<div>
					<h3 class="text-accent mb-2 font-bold">Core Concepts</h3>
					<p>Data Structures, Algorithms, DBMS, System Design, OOP, Multithreading, Concurrency</p>
				</div>
			</div>
		</section>

		<section>
			<h2 class="title mb-4">Achievements</h2>
			<ul class="space-y-2">
				<li>✓ First place in CODE BITES 5.0 (70+ contestants)</li>
				<li>✓ 195 problems solved on LeetCode, contest rating 1545</li>
				<li>✓ First runner-up at SIT Master Presenter 2026 (out of 10 teams)</li>
				<li>✓ Oracle Java Foundations - Java Explorer badge (100%)</li>
			</ul>
		</section>

		<section>
			<h2 class="title mb-4">Leadership</h2>
			<p>
				I serve as Technical Team Lead at the Computer Engineering Society. I've organized a 45-day
				DSA challenge for 50+ participants, handled scoring and dashboards for major events (150+
				students), and hosted hackathons for 40+ teams. I'm passionate about building communities
				and helping others grow technically.
			</p>
		</section>

		<section>
			<h2 class="title mb-4">Writing</h2>
			<p>
				I write on <a href="https://medium.com/@nimeshsharma760" target="_blank" class="cactus-link"
					>Medium </a
				>
				 about technical concepts and data analysis.
			</p>
		</section>

		<section>
			<h2 class="title mb-4">Beyond Code</h2>
			<p>
				I enjoy chess, basketball, and reading about technology and markets. I'm curious by
				nature—always asking questions, connecting dots, and looking for insights others might miss.
			</p>
		</section>
	</div>
</PageLayout>
